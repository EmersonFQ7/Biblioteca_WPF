<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- =========================  PALETA  ========================= -->
    <Color x:Key="FondoColor">#1E1E2E</Color>
    <Color x:Key="PanelColor">#282838</Color>
    <Color x:Key="SuperficieColor">#313145</Color>
    <Color x:Key="BordeColor">#3F3F55</Color>
    <Color x:Key="TextoColor">#E4E4E7</Color>
    <Color x:Key="TextoSuaveColor">#A1A1AA</Color>
    <Color x:Key="AcentoColor">#8B5CF6</Color>
    <Color x:Key="AcentoHoverColor">#A78BFA</Color>
    <Color x:Key="PeligroColor">#EF4444</Color>
    <Color x:Key="PeligroHoverColor">#F87171</Color>
    <Color x:Key="ExitoColor">#10B981</Color>

    <SolidColorBrush x:Key="Fondo"        Color="{StaticResource FondoColor}"/>
    <SolidColorBrush x:Key="Panel"        Color="{StaticResource PanelColor}"/>
    <SolidColorBrush x:Key="Superficie"   Color="{StaticResource SuperficieColor}"/>
    <SolidColorBrush x:Key="Borde"        Color="{StaticResource BordeColor}"/>
    <SolidColorBrush x:Key="Texto"        Color="{StaticResource TextoColor}"/>
    <SolidColorBrush x:Key="TextoSuave"   Color="{StaticResource TextoSuaveColor}"/>
    <SolidColorBrush x:Key="Acento"       Color="{StaticResource AcentoColor}"/>
    <SolidColorBrush x:Key="AcentoHover"  Color="{StaticResource AcentoHoverColor}"/>
    <SolidColorBrush x:Key="Peligro"      Color="{StaticResource PeligroColor}"/>
    <SolidColorBrush x:Key="PeligroHover" Color="{StaticResource PeligroHoverColor}"/>
    <SolidColorBrush x:Key="Exito"        Color="{StaticResource ExitoColor}"/>

    <!-- =========================  VENTANA  ========================= -->
    <Style TargetType="Window">
        <Setter Property="Background"  Value="{StaticResource Fondo}"/>
        <Setter Property="Foreground"  Value="{StaticResource Texto}"/>
        <Setter Property="FontFamily"  Value="Segoe UI"/>
        <Setter Property="FontSize"    Value="13"/>
    </Style>

    <!-- =========================  TEXTBLOCK  ========================= -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="Titulo" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <Style x:Key="Subtitulo" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        <Setter Property="Margin"     Value="0,0,0,16"/>
    </Style>

    <Style x:Key="Etiqueta" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource TextoSuave}"/>
        <Setter Property="Margin"     Value="0,0,0,4"/>
    </Style>

    <!-- =========================  TEXTBOX  ========================= -->
    <Style TargetType="TextBox">
        <Setter Property="Background"      Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground"      Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,8"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="CaretBrush"      Value="{StaticResource Acento}"/>
        <Setter Property="SelectionBrush"  Value="{StaticResource Acento}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource Acento}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource AcentoHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================  COMBOBOX  ========================= -->
    <!-- COMBOBOX ITEM (cada opcion del dropdown) -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding"    Value="10,8"/>
        <Setter Property="FontSize"   Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="borde"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource Superficie}"/>
                            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource Acento}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- COMBOBOX (el control completo con su dropdown) -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"      Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground"      Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="10,8"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment"   Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>

                        <!-- Caja principal con borde redondeado -->
                        <Border x:Name="borde"
                            Grid.ColumnSpan="2"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"/>

                        <!-- Texto seleccionado -->
                        <ContentPresenter Grid.Column="0"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>

                        <!-- Flecha -->
                        <Path Grid.Column="1"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 8 0 L 4 5 Z"
                          Fill="{StaticResource TextoSuave}"/>

                        <!-- Toggle invisible que abre o cierra el popup -->
                        <ToggleButton Grid.ColumnSpan="2"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- Dropdown desplegado -->
                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                            <Border Background="{StaticResource Panel}"
                                BorderBrush="{StaticResource Borde}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource AcentoHover}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource Acento}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================  DATEPICKER  ========================= -->
    <Style TargetType="DatePicker">
        <Setter Property="Background"  Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground"  Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Borde}"/>
        <Setter Property="Padding"     Value="6"/>
        <Setter Property="FontSize"    Value="13"/>
    </Style>

    <!-- =========================  BOTONES  ========================= -->
    <!-- Base invisible, de ella heredan los demas -->
    <Style x:Key="BotonBase" TargetType="Button">
        <Setter Property="Foreground"    Value="White"/>
        <Setter Property="FontWeight"    Value="SemiBold"/>
        <Setter Property="FontSize"      Value="13"/>
        <Setter Property="Padding"       Value="16,10"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="borde" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boton primario (morado) -->
    <Style x:Key="BotonPrimario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Acento}"/>
    </Style>

    <!-- Boton secundario (gris) -->
    <Style x:Key="BotonSecundario" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground" Value="{StaticResource Texto}"/>
    </Style>

    <!-- Boton peligro (rojo, para eliminar) -->
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonBase}">
        <Setter Property="Background" Value="{StaticResource Peligro}"/>
    </Style>

    <!-- Boton del menu lateral -->
    <Style x:Key="BotonMenu" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource TextoSuave}"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="Medium"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="20,14"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="borde"
                            Background="{TemplateBinding Background}"
                            BorderThickness="3,0,0,0"
                            BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde" Property="Background"  Value="{StaticResource Superficie}"/>
                            <Setter Property="Foreground" Value="{StaticResource Texto}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource Acento}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================  DATAGRID  ========================= -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"            Value="{StaticResource Panel}"/>
        <Setter Property="Foreground"            Value="{StaticResource Texto}"/>
        <Setter Property="BorderBrush"           Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness"       Value="1"/>
        <Setter Property="GridLinesVisibility"   Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Borde}"/>
        <Setter Property="RowBackground"         Value="{StaticResource Panel}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource Superficie}"/>
        <Setter Property="AutoGenerateColumns"   Value="False"/>
        <Setter Property="CanUserAddRows"        Value="False"/>
        <Setter Property="CanUserDeleteRows"     Value="False"/>
        <Setter Property="HeadersVisibility"     Value="Column"/>
        <Setter Property="RowHeight"             Value="40"/>
        <Setter Property="FontSize"              Value="13"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="{StaticResource Superficie}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextoSuave}"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="12,10"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="12,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Acento}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================  TARJETA / CARD  ========================= -->
    <Style x:Key="Tarjeta" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource Panel}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Borde}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="8"/>
        <Setter Property="Padding"         Value="20"/>
    </Style>

</ResourceDictionary>