<Window x:Class="Biblioteca.WPF.VentanaLibros"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion de Libros"
        Height="680" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Gestion de Libros" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Administra el catalogo de libros de la biblioteca"
                       Style="{StaticResource Subtitulo}"/>
        </StackPanel>

        <!-- BUSCADOR -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="txtBuscar"
                         Grid.Column="0"
                         Padding="12,10"
                         KeyDown="TxtBuscar_KeyDown"/>

                <Button Grid.Column="1" Content="Buscar"
                        Style="{StaticResource BotonPrimario}"
                        Margin="12,0,0,0"
                        Click="BtnBuscar_Click"/>
            </Grid>
        </Border>

        <!-- CONTENIDO: GRID Y FORMULARIO -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid de libros -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
                <DataGrid x:Name="dgLibros"
                          SelectionChanged="DgLibros_SelectionChanged"
                          IsReadOnly="True"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"         Binding="{Binding Id}"          Width="60"/>
                        <DataGridTextColumn Header="Titulo"     Binding="{Binding Titulo}"      Width="*"/>
                        <DataGridTextColumn Header="ISBN"       Binding="{Binding ISBN}"        Width="140"/>
                        <DataGridTextColumn Header="Autor"      Binding="{Binding NombreAutor}" Width="180"/>
                        <DataGridTextColumn Header="Ejemplares" Binding="{Binding Ejemplares}"  Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Formulario lateral -->
            <Border Grid.Column="1" Style="{StaticResource Tarjeta}" Margin="16,0,0,0">
                <StackPanel>
                    <TextBlock Text="Datos del libro" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Texto}" Margin="0,0,0,20"/>

                    <TextBlock Text="Titulo"    Style="{StaticResource Etiqueta}"/>
                    <TextBox   x:Name="txtTitulo" Margin="0,0,0,12"/>

                    <TextBlock Text="ISBN"      Style="{StaticResource Etiqueta}"/>
                    <TextBox   x:Name="txtIsbn"   Margin="0,0,0,12"/>

                    <TextBlock Text="Autor"     Style="{StaticResource Etiqueta}"/>
                    <ComboBox  x:Name="cboAutor"
                               DisplayMemberPath="Nombre"
                               SelectedValuePath="Id"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Ejemplares" Style="{StaticResource Etiqueta}"/>
                    <TextBox   x:Name="txtEjemplares" Margin="0,0,0,20"/>

                    <!-- Botones de accion -->
                    <Button Content="Guardar" Style="{StaticResource BotonPrimario}"
                            Margin="0,0,0,8" Click="BtnGuardar_Click"/>
                    <Button Content="Nuevo"   Style="{StaticResource BotonSecundario}"
                            Margin="0,0,0,8" Click="BtnNuevo_Click"/>
                    <Button Content="Eliminar" Style="{StaticResource BotonPeligro}"
                            Click="BtnEliminar_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>