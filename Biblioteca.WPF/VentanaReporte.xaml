<Window x:Class="Biblioteca.WPF.VentanaReporte"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reporte de Prestamos"
        Height="700" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Reporte de Prestamos" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Consulta los prestamos registrados en un intervalo de fechas"
                       Style="{StaticResource Subtitulo}"/>
        </StackPanel>

        <!-- FILTROS -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Desde" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpDesde"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Hasta" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpHasta"/>
                </StackPanel>

                <Button Grid.Column="3" Content="Generar reporte"
                        Style="{StaticResource BotonPrimario}"
                        VerticalAlignment="Bottom"
                        Width="180"
                        Click="BtnGenerar_Click"/>
            </Grid>
        </Border>

        <!-- RESULTADOS -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
            <DataGrid x:Name="dgReporte"
                      IsReadOnly="True"
                      Background="Transparent"
                      BorderThickness="0"
                      RowHeight="44">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N#"              Binding="{Binding Id}"                            Width="60"/>
                    <DataGridTextColumn Header="DNI"             Binding="{Binding DniSocio}"                      Width="100"/>
                    <DataGridTextColumn Header="Socio"           Binding="{Binding NombreSocio}"                   Width="200"/>
                    <DataGridTextColumn Header="Libros"          Binding="{Binding TituloLibros}"                  Width="*"/>
                    <DataGridTextColumn Header="Fecha prestamo"  Binding="{Binding FechaPrestamo, StringFormat=d}" Width="130"/>
                    <DataGridTextColumn Header="Fecha limite"    Binding="{Binding FechaLimite,   StringFormat=d}" Width="130"/>
                    <DataGridTextColumn Header="Estado"          Binding="{Binding Estado}"                        Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- RESUMEN -->
        <Border Grid.Row="3" Style="{StaticResource Tarjeta}" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Total prestamos" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="lblTotalPrestamos" Text="0"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Acento}"/>
                </StackPanel>

                <StackPanel Margin="0,0,40,0">
                    <TextBlock Text="Total libros prestados" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="lblTotalLibros" Text="0"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Acento}"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Prestamos pendientes" Style="{StaticResource Etiqueta}"/>
                    <TextBlock x:Name="lblPendientes" Text="0"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Exito}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- CERRAR -->
        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cerrar"
                    Style="{StaticResource BotonSecundario}"
                    Width="120"
                    Click="BtnCerrar_Click"/>
        </StackPanel>
    </Grid>
</Window>