<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca - Sistema de Gestion"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =========  MENU LATERAL  ========= -->
        <Border Grid.Column="0" Background="{StaticResource Panel}">
            <DockPanel>
                <!-- Logo / titulo -->
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,32">
                    <TextBlock Text="BIBLIOTECA"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Texto}"/>
                    <TextBlock Text="Sistema de gestion"
                               FontSize="11"
                               Foreground="{StaticResource TextoSuave}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Pie: version -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0 - Lab Semana 07"
                           FontSize="11"
                           Foreground="{StaticResource TextoSuave}"
                           Margin="24,0,24,20"/>

                <!-- Botones del menu -->
                <StackPanel>
                    <Button Content="  Libros"      Style="{StaticResource BotonMenu}" Click="BtnLibros_Click"/>
                    <Button Content="  Socios"      Style="{StaticResource BotonMenu}" Click="BtnSocios_Click"/>
                    <Button Content="  Prestamos"   Style="{StaticResource BotonMenu}" Click="BtnPrestamos_Click"/>
                    <Button Content="  Devoluciones" Style="{StaticResource BotonMenu}" Click="BtnDevoluciones_Click"/>
                    <Button Content="  Reportes"    Style="{StaticResource BotonMenu}" Click="BtnReportes_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- =========  AREA DE CONTENIDO  ========= -->
        <Grid Grid.Column="1" Background="{StaticResource Fondo}">
            <ContentControl x:Name="ContenidoPrincipal">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Bienvenido"
                               FontSize="32" FontWeight="Light"
                               Foreground="{StaticResource Texto}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Selecciona una opcion del menu lateral para comenzar"
                               FontSize="14"
                               Foreground="{StaticResource TextoSuave}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ContentControl>
        </Grid>
    </Grid>
</Window>