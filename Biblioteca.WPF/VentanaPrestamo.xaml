<Window x:Class="Biblioteca.WPF.VentanaPrestamo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Prestamo"
        Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ENCABEZADO -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Registrar Prestamo" Style="{StaticResource Titulo}"/>
            <TextBlock Text="Selecciona un socio y agrega los libros a prestar"
                       Style="{StaticResource Subtitulo}"/>
        </StackPanel>

        <!-- DATOS DEL PRESTAMO -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Socio" Style="{StaticResource Etiqueta}"/>
                    <ComboBox x:Name="cboSocio"
                              DisplayMemberPath="Nombre"
                              SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Fecha prestamo" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpFechaPrestamo"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Fecha limite" Style="{StaticResource Etiqueta}"/>
                    <DatePicker x:Name="dpFechaLimite"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO: LIBROS DISPONIBLES Y CARRITO -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Libros disponibles -->
            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Libros disponibles"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Texto}"
                               Margin="0,0,0,12"/>

                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtBuscarLibro"
                                 Grid.Column="0"
                                 Padding="10,6"
                                 KeyDown="TxtBuscarLibro_KeyDown"/>

                        <Button Grid.Column="1" Content="Buscar"
                                Style="{StaticResource BotonSecundario}"
                                Margin="8,0,0,0"
                                Click="BtnBuscarLibro_Click"/>
                    </Grid>

                    <DataGrid x:Name="dgDisponibles"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titulo"     Binding="{Binding Titulo}"      Width="*"/>
                            <DataGridTextColumn Header="Autor"      Binding="{Binding NombreAutor}" Width="150"/>
                            <DataGridTextColumn Header="Stock"      Binding="{Binding Ejemplares}"  Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Botones del medio -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                <Button Content="Agregar &gt;" Width="110"
                        Style="{StaticResource BotonPrimario}"
                        Margin="0,0,0,8"
                        Click="BtnAgregar_Click"/>
                <Button Content="&lt; Quitar" Width="110"
                        Style="{StaticResource BotonSecundario}"
                        Click="BtnQuitar_Click"/>
            </StackPanel>

            <!-- Carrito: libros a prestar -->
            <Border Grid.Column="2" Style="{StaticResource Tarjeta}" Padding="16">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Libros a prestar"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Texto}"
                               Margin="0,0,0,12"/>

                    <TextBlock x:Name="lblContador"
                               DockPanel.Dock="Top"
                               Text="0 libro(s) seleccionado(s)"
                               Foreground="{StaticResource TextoSuave}"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="dgCarrito"
                              IsReadOnly="True"
                              Background="Transparent"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titulo" Binding="{Binding Titulo}"      Width="*"/>
                            <DataGridTextColumn Header="Autor"  Binding="{Binding NombreAutor}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Botones de accion -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar"
                    Style="{StaticResource BotonSecundario}"
                    Width="120" Margin="0,0,8,0"
                    Click="BtnCancelar_Click"/>
            <Button Content="Registrar prestamo"
                    Style="{StaticResource BotonPrimario}"
                    Width="200"
                    Click="BtnRegistrar_Click"/>
        </StackPanel>
    </Grid>
</Window>